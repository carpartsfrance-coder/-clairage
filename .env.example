# ============================================================================
# LUMERA — variables d'environnement
#
# Copier en `.env` pour le développement local. Ce fichier ne contient AUCUN
# secret : il décrit seulement les clés attendues. Les valeurs réelles vivent
# dans le tableau de bord Render (ou dans un .env local jamais committé).
#
# Colonne « Render » :
#   auto     = fournie automatiquement par render.yaml
#   à saisir = à renseigner à la main dans le tableau de bord
# ============================================================================

# --- Base de données --------------------------------------------- Render: auto
# En local : créer la base avec `createdb lumera_dev`.
DATABASE_URL="postgresql://utilisateur@localhost:5432/lumera_dev?schema=public"

# --- Identité publique ------------------------------------------- Render: à saisir
# Sert aux URL canoniques, aux sitemaps et aux liens des e-mails.
NEXT_PUBLIC_SITE_URL="http://localhost:3400"

# Tant que « on » : bandeau de préproduction visible et site en noindex.
# Passer à « off » le jour de l'ouverture, une fois les données de
# démonstration retirées (npm run seed -- --purge-demo).
NEXT_PUBLIC_DEMO_MODE="on"

# --- Sessions ------------------------------------------------------ Render: —
# Aucun secret n'est nécessaire : le cookie de session porte un jeton aléatoire
# de 32 octets, et la base n'en garde que le condensé SHA-256. Rien n'est signé,
# donc il n'y a aucune clé à définir ni à faire tourner.
#
# Coût du hachage des mots de passe (scrypt, 2^N). Défaut : 15.
AUTH_SCRYPT_LOG_N="15"

# --- Stockage des médias ------------------------------------------ Render: à saisir
# `local` écrit dans ./public/uploads — utilisable UNIQUEMENT en développement :
# le disque de Render est éphémère et repart à zéro à chaque déploiement.
# `s3` vise n'importe quel stockage objet S3-compatible (Cloudflare R2,
# Backblaze B2, AWS S3, Scaleway). Voir docs/render.md.
MEDIA_DRIVER="local"
MEDIA_ENDPOINT=""
MEDIA_REGION="auto"
MEDIA_BUCKET=""
MEDIA_ACCESS_KEY_ID=""
MEDIA_SECRET_ACCESS_KEY=""
# Domaine public du bucket, déclaré à next/image. Sans protocole.
MEDIA_PUBLIC_HOST=""

# --- Paiement ------------------------------------------------------ Render: à saisir
# DEUX prestataires sont possibles. Renseignez la clé de CELUI que vous utilisez,
# et une seule : si les deux clés sont présentes, l'application refuse de
# choisir à votre place et demande PAYMENT_PROVIDER.
#
# Le mode test se déduit de la clé elle-même — pas d'une variable séparée qu'on
# pourrait oublier de basculer. Une clé dont le préfixe est inconnu est refusée
# plutôt qu'interprétée : ne pas savoir si une clé encaisse réellement est
# exactement le cas où il ne faut pas deviner.
#
# VIDES EN DÉVELOPPEMENT : un pilote de simulation prend alors le relais et
# permet de dérouler le tunnel (accepté, refusé, expiré) sans aucun compte.
# Chaque paiement simulé est marqué comme tel en base et à l'écran.
# EN PRODUCTION, aucune clé fait échouer l'ouverture du paiement — la simulation
# y est refusée, pour qu'aucune commande ne soit confirmée sans encaissement.

# Mollie — clé d'API, dans Mollie › Développeurs › Clés d'API.
#   test_…  mode test : Mollie répond pour de vrai, appelle le webhook pour de
#           vrai, mais aucun montant n'est encaissé. Seul l'EUR est accepté.
#   live_…  encaisse réellement.
# Mollie ne signe pas ses webhooks : il POSTe l'identifiant du paiement, et
# c'est la relecture par l'API avec cette clé qui fait foi. Il n'y a donc aucun
# secret de webhook à définir.
MOLLIE_API_KEY=""

# Stripe — clé secrète (sk_test_… ou sk_live_…).
STRIPE_SECRET_KEY=""
# Secret de signature du webhook Stripe (`whsec_…`), obtenu en déclarant le
# point de terminaison https://<domaine>/api/paiement/webhook dans Stripe.
# Sans lui, la route refuse tout appel Stripe.
STRIPE_WEBHOOK_SECRET=""

# Arbitrage, UNIQUEMENT si les deux clés ci-dessus sont renseignées.
# Valeurs acceptées : mollie, stripe.
PAYMENT_PROVIDER=""

# ⚠ Mollie refuse une URL de webhook non publique : « you cannot use localhost ».
#   En local, l'application omet donc le champ et rapproche le paiement au
#   retour du client — c'est suffisant pour vérifier le tunnel. Pour recevoir
#   de vrais webhooks en développement, exposez le site (ngrok ou équivalent)
#   et reportez l'URL publique dans NEXT_PUBLIC_SITE_URL.

# --- E-mails transactionnels --------------------------------------- Render: à saisir
# `log`        : aucun envoi réel. Chaque message est écrit dans la table
#                EmailLog avec simulated=true et consultable dans le back-office.
#                C'est le réglage par défaut, et le seul acceptable tant que le
#                domaine n'est pas authentifié.
# `mailersend` | `brevo` | `resend` : envoi réel.
EMAIL_DRIVER="log"
EMAIL_FROM=""
EMAIL_API_KEY=""

# --- Authentification ------------------------------------------- Render: facultatif
# Coût du hachage scrypt, en log2 de N (14 à 20). Par défaut 15, soit ~32 Mo et
# ~150 ms par vérification — calibré pour une instance Render de 512 Mo.
# Monter à 16 ou 17 dès que l'instance a la mémoire : les comptes existants
# restent valides, chaque condensé portant ses propres paramètres.
AUTH_SCRYPT_LOG_N="15"

# --- Travaux de fond ------------------------------------------------ Render: auto
# Jeton partagé entre le cron et /api/jobs/run.
JOB_RUNNER_TOKEN=""
