# ============================================================================
# LUMERA — variables d'environnement
#
# Copier en `.env` pour le développement local. Ce fichier ne contient AUCUN
# secret : il décrit seulement les clés attendues. Les valeurs réelles vivent
# dans le tableau de bord Render (ou dans un .env local jamais committé).
#
# Colonne « Render » :
#   auto     = fournie automatiquement par render.yaml
#   à saisir = à renseigner à la main dans le tableau de bord
# ============================================================================

# --- Base de données --------------------------------------------- Render: auto
# En local : créer la base avec `createdb lumera_dev`.
DATABASE_URL="postgresql://utilisateur@localhost:5432/lumera_dev?schema=public"

# --- Identité publique ------------------------------------------- Render: à saisir
# Sert aux URL canoniques, aux sitemaps et aux liens des e-mails.
NEXT_PUBLIC_SITE_URL="http://localhost:3400"

# Tant que « on » : bandeau de préproduction visible et site en noindex.
# Passer à « off » le jour de l'ouverture, une fois les données de
# démonstration retirées (npm run seed -- --purge-demo).
NEXT_PUBLIC_DEMO_MODE="on"

# --- Sessions ------------------------------------------------------ Render: auto
# Chaîne aléatoire d'au moins 32 caractères. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Stockage des médias ------------------------------------------ Render: à saisir
# `local` écrit dans ./public/uploads — utilisable UNIQUEMENT en développement :
# le disque de Render est éphémère et repart à zéro à chaque déploiement.
# `s3` vise n'importe quel stockage objet S3-compatible (Cloudflare R2,
# Backblaze B2, AWS S3, Scaleway). Voir docs/render.md.
MEDIA_DRIVER="local"
MEDIA_ENDPOINT=""
MEDIA_REGION="auto"
MEDIA_BUCKET=""
MEDIA_ACCESS_KEY_ID=""
MEDIA_SECRET_ACCESS_KEY=""
# Domaine public du bucket, déclaré à next/image. Sans protocole.
MEDIA_PUBLIC_HOST=""

# --- Paiement ------------------------------------------------------ Render: à saisir
# `stripe` ou `mollie`. Commencer en mode test dans les deux cas.
PAYMENT_PROVIDER="stripe"
PAYMENT_TEST_MODE="true"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Si PAYMENT_PROVIDER=mollie
MOLLIE_API_KEY=""

# --- E-mails transactionnels --------------------------------------- Render: à saisir
# `log`        : aucun envoi réel. Chaque message est écrit dans la table
#                EmailLog avec simulated=true et consultable dans le back-office.
#                C'est le réglage par défaut, et le seul acceptable tant que le
#                domaine n'est pas authentifié.
# `mailersend` | `brevo` | `resend` : envoi réel.
EMAIL_DRIVER="log"
EMAIL_FROM=""
EMAIL_API_KEY=""

# --- Travaux de fond ------------------------------------------------ Render: auto
# Jeton partagé entre le cron et /api/jobs/run.
JOB_RUNNER_TOKEN=""
